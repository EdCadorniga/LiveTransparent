        "jsonBody": "={\n  \"provider\": \"linkedin\",\n  \"profileUrl\": $node[\"Normalize Payload\"].json.profileUrl,\n  \"message\": $node[\"Normalize Payload\"].json.finalMessage\n}",
        "options": {}
      },
