    {
      "parameters": {
        "functionCode": "// Normalize incoming GHL webhook or generic payload\nconst src = ($json.body && typeof $json.body === 'object') ? $json.body : $json;\nconst contact = src.contact && typeof src.contact === 'object' ? src.contact : src;\nfunction get(keys) {\n  for (const k of keys) {\n    const v = contact?.[k] ?? src?.[k] ?? $json?.[k];\n    if (v !== undefined && v !== null && String(v).trim() !== '') return String(v).trim();\n  }\n  return '';\n}\n// possible linkedin fields in incoming payloads\nconst linkedin = get(['linkedin_profile_url','linkedin_url','linkedin','profileUrl','profile_url','LinkedIn URL']);\nconst firstName = get(['first_name','firstName','firstname','contactFirstName','Contact First Name']);\nconst lastName = get(['last_name','lastName','lastname','contactLastName','Contact Last Name']);\nconst contactId = get(['contactId','contact_id','id','contact.id']);\nconst suppliedMessage = (src.message || src.msg || src.note || contact?.message) || '';\nconst finalMessage = suppliedMessage || (`Hi ${firstName || ''}${firstName ? ',' : ''} I'd like to connect and share ideas.`).trim();\nreturn [{ json: { profileUrl: linkedin, firstName, lastName, contactId, finalMessage } }];"
      },
      "id": "node-normalize-1",
      "name": "Normalize Payload",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        680,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "= {{$node[\"Config\"].json.apiBaseUrl}}/outreach/invitations",
        "sendHeaders": true,
        "headerParameters": {
