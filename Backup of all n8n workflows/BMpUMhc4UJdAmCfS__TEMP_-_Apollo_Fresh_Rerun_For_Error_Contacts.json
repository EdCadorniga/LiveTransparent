    {
      "parameters": {
        "jsCode": "const cfg = $json || {};\nconst contactIds = Array.isArray(cfg.contactIds) ? cfg.contactIds : [];\n\nasync function doHttpRequest(options) {\n  if (typeof $httpRequest === 'function') return await $httpRequest(options);\n  if (this?.helpers?.httpRequest) return await this.helpers.httpRequest(options);\n  throw new Error('HTTP helper not available');\n}\nasync function callWebhook(contactId) {\n  const options = {\n    method: 'POST',\n    url: cfg.webhookUrl,\n    headers: {\n      'Content-Type': 'application/json',\n      'X-LT-Webhook-Key': cfg.webhookKey,\n      'Accept': 'application/json',\n      'User-Agent': 'Mozilla/5.0',\n    },\n    body: {\n      contactId,\n      rerunSource: 'temp_error_backfill_fresh_apollo',\n      forceOverwritePhone: false,\n    },\n    json: true,\n  };\n  try {\n    const data = await doHttpRequest.call(this, options);\n    return { contactId, ok: true, response: data };\n  } catch (err) {\n    return {\n      contactId,\n      ok: false,\n      status: err?.statusCode || err?.httpCode || err?.cause?.statusCode || null,\n      response: err?.response?.body || err?.message || String(err),\n    };\n  }\n}\n\nconst results = [];\nfor (const contactId of contactIds) {\n  results.push(await callWebhook.call(this, contactId));\n}\nconst summary = results.reduce((acc, item) => {\n  acc.total += 1;\n  if (item.ok) acc.success += 1;\n  else acc.error += 1;\n  const reason = item.ok ? (item.response?.reason || item.response?.status || 'ok') : 'request_failed';\n  acc.byReason[reason] = (acc.byReason[reason] || 0) + 1;\n  return acc;\n}, { total: 0, success: 0, error: 0, byReason: {} });\nreturn [{ json: { summary, results } }];"
      },
