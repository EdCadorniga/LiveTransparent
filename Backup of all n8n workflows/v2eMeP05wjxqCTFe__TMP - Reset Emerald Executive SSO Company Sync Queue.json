  "name": "TMP - Reset Emerald Executive SSO Company Sync Queue",
  "description": null,
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "content": "Temporary reset workflow for Emerald Executive SSO company research reruns.\n\nWhat it does\n- Deletes company cache rows for contacts tagged seq emerald - executives sso\n- Resets Emerald_Contacts sync/research fields so the company sync workflow can pick them up again\n\nUse\n- Run manually only\n- Archive after use",
        "height": 340,
        "width": 520
      },
      "id": "note_reset_emerald_exec_sso",
      "name": "Reset Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -520,
        -160
      ]
    },
    {
      "parameters": {},
      "id": "manual_trigger_reset_emerald_exec_sso",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -240,
        80
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM \"Emerald_Company_Research_Cache\"\nWHERE company_domain_key IN (\n  SELECT DISTINCT company_domain_key\n  FROM \"Emerald_Contacts\"\n  WHERE LOWER(COALESCE(tags::text, '')) LIKE '%seq emerald - executives sso%'\n    AND company_domain_key IS NOT NULL\n    AND company_domain_key <> ''\n);",
        "options": {}
      },
      "id": "delete_emerald_exec_sso_cache",
      "name": "Delete Executive SSO Cache Rows",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        0,
        80
      ],
      "credentials": {
        "postgres": {
          "id": "pgAzUqpwOiGkGXzO",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE \"Emerald_Contacts\"\nSET\n  ghl_contact_sync_status = 'pending',\n  ghl_contact_sync_error = '',\n  emerald_exec_sso_ai_research = NULL,\n  company_research_snippet = NULL,\n  company_operating_state = NULL,\n  company_operating_market_note = NULL,\n  company_cannabis_marketing_signal = NULL,\n  company_research_confidence = NULL,\n  company_research_source = NULL,\n  company_research_last_verified_at = NULL,\n  updated_at = NOW()\nWHERE LOWER(COALESCE(tags::text, '')) LIKE '%seq emerald - executives sso%';",
        "options": {}
      },
      "id": "reset_emerald_exec_sso_contacts",
      "name": "Reset Executive SSO Contacts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        256,
        80
      ],
      "credentials": {
        "postgres": {
          "id": "pgAzUqpwOiGkGXzO",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ok: true, note: 'Executive SSO company cache deleted and Emerald_Contacts reset to pending for company sync rerun.' } }];"
      },
      "id": "summarize_reset_emerald_exec_sso",
      "name": "Summarize Reset",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        80
      ]
    }
  ],
