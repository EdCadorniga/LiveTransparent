    {
      "id": "5f58ea6f-add7-4ae4-a415-437893cf856f",
      "name": "Build Publish SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $json || {};\nconst payload = {\n  locationId: String(cfg.locationId || '').trim(),\n  locationName: String(cfg.locationName || '').trim(),\n  timezone: String(cfg.timezone || 'America/Los_Angeles').trim(),\n  reportHost: String(cfg.reportHost || 'https://reports.livetransparent.com').trim(),\n  embedUrl: String(cfg.embedUrl || 'https://reports.livetransparent.com/embed/executive').trim(),\n  view: String(cfg.view || 'overview').trim(),\n  range: String(cfg.range || '30d').trim(),\n  refreshedAt: new Date().toISOString(),\n  reason: 'config or rollup refresh',\n};\nconst jsonb = \"'\" + JSON.stringify(payload).replace(/'/g, \"''\") + \"'::jsonb\";\nconst sql = \"INSERT INTO report_config (config_key, config_value, notes, updated_at) VALUES ('report_publish_state', \" + jsonb + \", 'Latest report publish refresh marker', NOW()) ON CONFLICT (config_key) DO UPDATE SET config_value = EXCLUDED.config_value, notes = EXCLUDED.notes, updated_at = NOW();\";\nreturn [{ json: { ...payload, upsertSql: sql } }];"
      }
    },
    {
      "id": "78a0a81f-7264-4f4e-ad8e-0b2338ecba24",
      "name": "Upsert Publish State",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        960,
        240
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "={{$json.upsertSql}}",
        "options": {
          "queryBatching": "independently"
        }
      },
      "credentials": {
        "postgres": {
          "id": "pgAzUqpwOiGkGXzO",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "81d750e1-3b11-4495-a482-81f06727c9fc",
      "name": "Summarize Publish Refresh",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $json || {};\nreturn [{ json: { ok: true, workflow: 'LT - Report Publish Refresh', refreshMarker: item.refreshedAt, embedUrl: item.embedUrl, view: item.view, range: item.range, note: 'Publish state recorded in Postgres.' } }];"
      }
    }
