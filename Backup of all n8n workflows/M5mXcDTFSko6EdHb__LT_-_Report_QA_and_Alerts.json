  "name": "LT - Report QA and Alerts",
  "description": "Checks report source health for blocked or stale sources and returns a simple QA status summary.",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "cb42a799-3d6a-427e-9aa8-fee8cc90e393",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        160
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 60
            }
          ]
        }
      }
    },
    {
      "id": "e297e8a2-069a-4238-bf6d-262e567312f9",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        240
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "location_id",
              "name": "locationId",
              "value": "Zwz4relUXVPxx8uohnjV",
              "type": "string"
            },
            {
              "id": "location_name",
              "name": "locationName",
              "value": "Live Transparent",
              "type": "string"
            },
            {
              "id": "timezone",
              "name": "timezone",
              "value": "America/Los_Angeles",
              "type": "string"
            },
            {
              "id": "stale_after_hours",
              "name": "staleAfterHours",
              "value": 48,
              "type": "number"
            },
            {
              "id": "blocked_note",
              "name": "blockedNote",
              "value": "GA4 property ID pending from Cameron",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "34f92e6b-5aa4-4fb1-a7a3-d9b38abd4405",
      "name": "Fetch Source Health",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        720,
        240
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT source_system, status, last_attempt_at, last_success_at, last_row_count, stale_after_hours, last_error, metadata, updated_at FROM report_source_health ORDER BY source_system;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "pgAzUqpwOiGkGXzO",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "e164bae0-9d37-4224-a4b1-561e4d50e1b2",
      "name": "Evaluate QA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        240
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map((item) => item.json || {});\nconst blocked = rows.filter((row) => String(row.status || '').toLowerCase() === 'blocked');\nconst stale = rows.filter((row) => {\n  const lastSuccess = row.last_success_at ? new Date(row.last_success_at).getTime() : 0;\n  const staleHours = Number(row.stale_after_hours || 0);\n  if (!lastSuccess || !staleHours) return false;\n  return (Date.now() - lastSuccess) > staleHours * 3600 * 1000;\n});\nconst ready = rows.filter((row) => String(row.status || '').toLowerCase() === 'ready');\nconst issues = [\n  ...blocked.map((row) => `${row.source_system}: blocked${row.last_error ? ` (${row.last_error})` : ''}`),\n  ...stale.map((row) => `${row.source_system}: stale`),\n];\nreturn [{ json: { ok: issues.length === 0, totalSources: rows.length, readySources: ready.length, blockedSources: blocked.length, staleSources: stale.length, issues, rows } }];"
      }
    },
    {
      "id": "f2f387c9-a427-435a-a7cf-999bd54c38ce",
      "name": "Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1200,
        240
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "status",
              "name": "status",
              "value": "={{ $json.ok ? 'ok' : 'attention_required' }}",
              "type": "string"
            },
            {
              "id": "summary",
              "name": "summary",
              "value": "={{ $json.ok ? 'Report sources are healthy.' : 'Report QA found issues.' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "fb81b3a5-bcc0-41ce-8bc6-873b52c83213",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        320
      ],
      "parameters": {}
    }
  ],
