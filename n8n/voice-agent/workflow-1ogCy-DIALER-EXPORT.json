    {
      "id": "d4c5c08a-901e-4e5c-8ae9-ff92bb42a377",
      "name": "Code - Check Phone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        192
      ],
      "parameters": {
        "jsCode": "const queueCtx = $('Code - Queue Guard').item.json;\nconst body = $json;\nconst ghlContact = body.contact || body;\nconst ghlPhone = ghlContact.phone || '';\nconst fallbackPhone = queueCtx.phone_e164 || '';\nconst phone = ghlPhone || fallbackPhone;\nconst isValidE164 = /^\\+[1-9]\\d{6,14}$/.test(phone);\nconst validPhone = isValidE164 ? phone : '';\nconst tz = queueCtx.lead_timezone || '';\nlet outside_hours = false;\nif (tz) {\n  try {\n    const now = new Date(new Date().toLocaleString('en-US', { timeZone: tz }));\n    const day = now.getDay();\n    const hour = now.getHours();\n    outside_hours = !(day >= 1 && day <= 5 && hour >= 9 && hour < 17);\n  } catch (e) {\n    outside_hours = false;\n  }\n}\nreturn [{ json: { ...queueCtx, phone_e164: validPhone, phone_source: ghlPhone ? 'ghl' : 'queue', outside_hours } }];"
      }
    },
