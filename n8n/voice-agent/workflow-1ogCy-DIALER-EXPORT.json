    {
      "id": "964e85d8-2200-49c4-a246-f641b923aaf8",
      "name": "Build Vapi Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        192
      ],
      "parameters": {
        "jsCode": "const data = $input.all()[0].json;\nreturn [{\n  json: {\n    body: JSON.stringify({\n      phoneNumberId: \"bd4ba248-a2b4-4738-b701-7c6a5ebb5bb4\",\n      customer: { number: data.phone_e164 },\n      assistantId: \"3f9bbfd2-efa6-4381-81e6-26f2452d28f1\",\n      assistantOverrides: {\n        variableValues: {\n          contact_id: data.contact_id,\n          queue_id: data.queue_id,\n          campaign_id: data.campaign_id,\n          lead_timezone: data.lead_timezone || \"\",\n          first_name: data.first_name || \"\"\n        },\n        metadata: {\n          source: \"n8n-outbound-dialer\",\n          contact_id: data.contact_id,\n          queue_id: data.queue_id,\n          campaign_id: data.campaign_id\n        }\n      }\n    })\n  }\n}];\n"
      }
