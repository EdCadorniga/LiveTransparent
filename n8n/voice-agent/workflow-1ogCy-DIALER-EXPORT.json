    {
      "id": "3b73e810-6dd9-42e3-b37b-9557b1f582d2",
      "name": "Postgres - Fetch Next Queue Item",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        448,
        288
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH candidate AS (SELECT queue_id FROM voice_call_queue WHERE status = 'pending' AND dnc = false AND attempt_count < max_attempts AND (next_attempt_at IS NULL OR next_attempt_at <= NOW()) AND (locked_at IS NULL OR locked_at < NOW() - INTERVAL '15 minutes') ORDER BY created_at DESC LIMIT 1) UPDATE voice_call_queue q SET locked_at = NOW(), lock_owner = 'n8n-dialer', updated_at = NOW() FROM candidate WHERE q.queue_id = candidate.queue_id RETURNING q.queue_id, q.contact_id, q.first_name, q.phone_e164, q.campaign_id, q.lead_timezone, q.max_attempts, q.attempt_count",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "pgAzUqpwOiGkGXzO",
          "name": "Postgres account"
        }
      }
