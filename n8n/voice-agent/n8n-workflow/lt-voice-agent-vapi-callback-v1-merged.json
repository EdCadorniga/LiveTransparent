        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"body\": \"AI call completed. Disposition: \" + $json.disposition + \"\\nSummary: \" + ($json.summary || \"n/a\") + \"\\nRecording: \" + ($json.recording_url || \"n/a\")}"
      },
      "id": "ghl_note",
      "name": "GHL - Contact Note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1520,
        500
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\": true, \"contact_id\": \"{{ $json.contact_id }}\", \"queue_id\": \"{{ $json.queue_id }}\", \"tool\": \"{{ $json.tool_name }}\"}"
      },
      "id": "resp",
      "name": "Respond - 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.3,
      "position": [
        1920,
