{
  "name": "LT - Voice Agent V1 Outbound Dialer (Vapi)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "cron_1",
      "name": "Cron - Queue Poll",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        280
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with candidate as (\n  select queue_id\n  from voice_call_queue\n  where status = 'pending'\n    and dnc = false\n    and attempt_count < max_attempts\n    and (next_attempt_at is null or next_attempt_at <= now())\n    and (locked_at is null or locked_at < now() - interval '15 minutes')\n  order by coalesce(next_attempt_at, created_at) asc\n  limit 1\n)\nupdate voice_call_queue q\nset locked_at = now(),\n    lock_owner = 'orJrDqR6hQjgPLpg',\n    attempt_count = attempt_count + 1,\n    last_attempt_at = now(),\n    next_attempt_at = now() + interval '15 minutes',\n    updated_at = now()\nfrom candidate c\nwhere q.queue_id = c.queue_id\nreturning q.queue_id, q.contact_id, q.first_name, q.phone_e164, q.campaign_id, q.lead_timezone, q.max_attempts, q.attempt_count;"
      },
      "id": "pg_1",
      "name": "Postgres - Fetch Next Queue Item",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        520,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "const row = $json;\nif (!row || !row.queue_id) {\n  return [{ json: { skip: true, reason: 'empty_queue' } }];\n}\nreturn [{ json: { ...row, skip: false } }];"
      },
      "id": "code_1",
      "name": "Code - Queue Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        280
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "value1": "={{ String($json.skip) }}",
              "value2": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        }
      },
      "id": "if_1",
      "name": "If - Skip Empty",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        980,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.VAPI_BASE_URL || 'https://api.vapi.ai/call'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.VAPI_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { phoneNumberId: $env.VAPI_PHONE_NUMBER_ID, customer: { number: $json.phone_e164 }, assistantId: $env.VAPI_ASSISTANT_ID, assistantOverrides: { variableValues: { contact_id: $json.contact_id, queue_id: $json.queue_id, campaign_id: $json.campaign_id, lead_timezone: $json.lead_timezone || '', first_name: $json.first_name || '' }, metadata: { source: 'n8n-outbound-dialer', contact_id: $json.contact_id, queue_id: $json.queue_id, campaign_id: $json.campaign_id } } } }}"
      },
      "id": "http_1",
      "name": "HTTP - Start Vapi Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1220,
        360
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{\"https://services.leadconnectorhq.com/contacts/\" + $json.contact_id + \"/notes\"}}",
        "jsonBody": "={{ { body: \"AI outbound Vapi call started. queue_id=\" + $json.queue_id + \", contact_id=\" + $json.contact_id } }}",
        "specifyBody": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{\"Bearer \" + $env.GHL_API_KEY}}"
            },
            {
              "name": "Version",
              "value": "2021-07-28"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendHeaders": true,
        "sendBody": true
      },
      "id": "ghl_1",
      "name": "GHL - Create Call Note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1450,
        360
      ]
    }
  ],
  "connections": {
    "Cron - Queue Poll": {
      "main": [
        [
          {
            "node": "Postgres - Fetch Next Queue Item",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres - Fetch Next Queue Item": {
      "main": [
        [
          {
            "node": "Code - Queue Guard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code - Queue Guard": {
      "main": [
        [
          {
            "node": "If - Skip Empty",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If - Skip Empty": {
      "main": [
        [],
        [
          {
            "node": "HTTP - Start Vapi Call",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP - Start Vapi Call": {
      "main": [
        [
          {
            "node": "GHL - Create Call Note",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "active": false
}
