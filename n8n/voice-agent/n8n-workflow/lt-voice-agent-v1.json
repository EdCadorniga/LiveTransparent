{
  "name": "LT - Voice Agent V1 Outbound Dialer (Vapi)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "cron_1",
      "name": "Cron - Queue Poll",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        280
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select queue_id, contact_id, first_name, phone_e164, campaign_id, lead_timezone, max_attempts, attempt_count\nfrom voice_call_queue\nwhere status = 'pending'\n  and dnc = false\n  and attempt_count < max_attempts\n  and (next_attempt_at is null or next_attempt_at <= now())\norder by coalesce(next_attempt_at, created_at) asc\nlimit 1;"
      },
      "id": "pg_1",
      "name": "Postgres - Fetch Next Queue Item",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        520,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "const row = $json;\nif (!row || !row.queue_id) {\n  return [{ json: { skip: true, reason: 'empty_queue' } }];\n}\nreturn [{ json: { ...row, skip: false } }];"
      },
      "id": "code_1",
      "name": "Code - Queue Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        280
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.skip}}",
              "value2": true
            }
          ]
        }
      },
      "id": "if_1",
      "name": "If - Skip Empty",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        980,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.VAPI_BASE_URL || 'https://api.vapi.ai/call'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.VAPI_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { phoneNumberId: $env.VAPI_PHONE_NUMBER_ID, customer: { number: $json.phone_e164 }, assistantId: $env.VAPI_ASSISTANT_ID, assistantOverrides: { variableValues: { contact_id: $json.contact_id, queue_id: $json.queue_id, campaign_id: $json.campaign_id, lead_timezone: $json.lead_timezone || '', first_name: $json.first_name || '' }, metadata: { source: 'n8n-outbound-dialer', contact_id: $json.contact_id, queue_id: $json.queue_id, campaign_id: $json.campaign_id } } } }}"
      },
      "id": "http_1",
      "name": "HTTP - Start Vapi Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1220,
        360
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{\"https://services.leadconnectorhq.com/contacts/\" + $json.contact_id + \"/notes\"}}",
        "jsonBody": "={{ { body: \"AI outbound Vapi call started. queue_id=\" + $json.queue_id + \", contact_id=\" + $json.contact_id } }}",
        "specifyBody": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{\"Bearer \" + $env.GHL_API_KEY}}"
            },
            {
              "name": "Version",
              "value": "2021-07-28"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendHeaders": true,
        "sendBody": true
      },
      "id": "ghl_1",
      "name": "GHL - Create Call Note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1450,
        360
      ]
    }
  ],
  "connections": {
    "Cron - Queue Poll": {
      "main": [
        [
          {
            "node": "Postgres - Fetch Next Queue Item",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres - Fetch Next Queue Item": {
      "main": [
        [
          {
            "node": "Code - Queue Guard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code - Queue Guard": {
      "main": [
        [
          {
            "node": "If - Skip Empty",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If - Skip Empty": {
      "main": [
        [],
        [
          {
            "node": "HTTP - Start Vapi Call",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP - Start Vapi Call": {
      "main": [
        [
          {
            "node": "GHL - Create Call Note",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "active": false
}