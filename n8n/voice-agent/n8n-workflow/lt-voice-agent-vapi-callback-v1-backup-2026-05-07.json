"{\n  \"name\": \"LT - Voice Agent V1 Vapi Callback Sync\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"lt-voice-agent-vapi-callback\",\n        \"responseMode\": \"lastNode\"\n      },\n      \"id\": \"webhook_1\",\n      \"name\": \"Webhook - Vapi End Of Call\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2.1,\n      \"position\": [240, 320]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const body = $json.body || $json;\\nconst call = body.call || body;\\nconst artifact = body.artifact || {};\\nconst analysis = body.analysis || {};\\nconst meta = (call.assistantOverrides && call.assistantOverrides.metadata) || call.metadata || {};\\n\\nconst contactId = String(meta.contact_id || '').trim();\\nconst queueId = String(meta.queue_id || '').trim();\\nconst campaignId = String(meta.campaign_id || '').trim();\\n\\nconst status = String(call.status || body.status || '').toLowerCase();\\nconst endedReason = String(call.endedReason || '').toLowerCase();\\nconst successEvaluation = !!analysis.successEvaluation;\\nconst summary = String(analysis.summary || artifact.summary || '').trim();\\nconst transcript = artifact.transcript || call.transcript || '';\\n\\nlet disposition = 'failed';\\nif (status.includes('ended') || status.includes('completed')) {\\n  if (endedReason.includes('customer-did-not-answer') || endedReason.includes('no-answer')) disposition = 'no_answer';\\n  else if (endedReason.includes('voicemail')) disposition = 'voicemail';\\n  else disposition = successEvaluation ? 'qualified_booked' : 'connected';\\n}\\n\\nreturn [{ json: { contact_id: contactId, queue_id: queueId, campaign_id: campaignId, call_id: String(call.id || body.id || ''), disposition, summary: summary || 'No summary returned by Vapi.', transcript_text: typeof transcript === 'string' ? transcript : JSON.stringify(transcript), recording_url: artifact.recordingUrl || call.recordingUrl || '', raw_status: status, raw_ended_reason: endedReason } }];\"\n      },\n      \"id\": \"code_1\",\n      \"name\": \"Code - Normalize Callback\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [520, 320]\n    },\n    {\n      \"parameters\": {\n        \"operation\": \"executeQuery\",\n        \"query\": \"insert into voice_call_attempt (call_id, queue_id, contact_id, provider_call_id, idempotency_key, disposition, summary, transcript_url, recording_url)\\nvalues (\\n  nullif({{ $json.call_id ? \\\"'\\\" + $json.call_id + \\\"'\\\" : \\\"null\\\" }}, null)::uuid,\\n  nullif({{ $json.queue_id ? \\\"'\\\" + $json.queue_id + \\\"'\\\" : \\\"null\\\" }}, null)::uuid,\\n  '{{ $json.contact_id }}',\\n  '{{ $json.call_id }}',\\n  '{{ $json.call_id }}:{{ $json.disposition }}',\\n  '{{ $json.disposition }}',\\n  '{{ ($json.summary || \\\"\\\").replace(/'/g, \\\"''\\\") }}',\\n  '',\\n  '{{ $json.recording_url }}'\\n)\\non conflict (idempotency_key) do nothing;\"\n      },\n      \"id\": \"pg_1\",\n      \"name\": \"Postgres - Insert Attempt\",\n      \"type\": \"n8n-nodes-base.postgres\",\n      \"typeVersion\": 2.5,\n      \"position\": [800, 320]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{\\\"https://services.leadconnectorhq.com/contacts/\\\" + $json.contact_id + \\\"/notes\\\"}}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            { \"name\": \"Authorization\", \"value\": \"={{\\\"Bearer \\\" + $env.GHL_API_KEY}}\" },\n            { \"name\": \"Version\", \"value\": \"2021-07-28\" },\n            { \"name\": \"Content-Type\", \"value\": \"application/json\" },\n            { \"name\": \"Accept\", \"value\": \"application/json\" }\n          ]\n        },\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ { body: \\\"AI call completed. Disposition: \\\" + $json.disposition + \\\"\\\\nSummary: \\\" + ($json.summary || \\\"n/a\\\") + \\\"\\\\nRecording: \\\" + ($json.recording_url || \\\"n/a\\\") } }}\"\n      },\n      \"id\": \"http_1\",\n      \"name\": \"HTTP - GHL Contact Note\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [1080, 320]\n    },\n    {\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"={{ { ok: true, contact_id: $json.contact_id, queue_id: $json.queue_id, disposition: $json.disposition } }}\"\n      },\n      \"id\": \"resp_1\",\n      \"name\": \"Respond - 200\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1.3,\n      \"position\": [1320, 320]\n    }\n  ],\n  \"connections\": {\n    \"Webhook - Vapi End Of Call\": {\n      \"main\": [[{ \"node\": \"Code - Normalize Callback\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"Code - Normalize Callback\": {\n      \"main\": [[{ \"node\": \"Postgres - Insert Attempt\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"Postgres - Insert Attempt\": {\n      \"main\": [[{ \"node\": \"HTTP - GHL Contact Note\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"HTTP - GHL Contact Note\": {\n      \"main\": [[{ \"node\": \"Respond - 200\", \"type\": \"main\", \"index\": 0 }]]\n    }\n  },\n  \"settings\": {},\n  \"active\": false\n}\n"
