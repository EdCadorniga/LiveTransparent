        240,
        240
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const status = $json.business_hours_status;\nif (status === 'outside') {\n  return [];\n}\nreturn [{ json: $json }];"
      },
