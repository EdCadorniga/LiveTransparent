    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const ct = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Chicago' }));\nconst day = ct.getDay();\nconst hour = ct.getHours();\nconst inBusinessHours = day >= 1 && day <= 5 && hour >= 9 && hour < 17;\nreturn [{ json: { business_hours_status: inBusinessHours ? 'inside' : 'outside' } }];"
      },
      "id": "d0c3b309-de55-49ca-9416-483f76e730d1",
